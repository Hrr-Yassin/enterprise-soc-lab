<ossec_config>
  <client>
    <server>
      <address>10.0.2.100</address>
      <port>1514</port>
      <protocol>tcp</protocol>
    </server>
    <notify_time>15</notify_time>
    <time-reconnect>30</time-reconnect>
    <crypto_method>aes</crypto_method>
    <enrollment><enabled>no</enabled></enrollment>
  </client>
  <client_buffer>
    <disabled>no</disabled>
    <queue_size>5000</queue_size>
    <events_per_second>200</events_per_second>
  </client_buffer>
  <rootcheck><disabled>yes</disabled></rootcheck>
  <sca><enabled>no</enabled></sca>
  <syscheck>
    <disabled>no</disabled>
    <frequency>300</frequency>
    <scan_on_start>yes</scan_on_start>
    <directories check_all="yes" realtime="yes" report_changes="yes">/var/lib/soc-lab/files</directories>
  </syscheck>
  <localfile><location>/var/log/soc-lab/system.log</location><log_format>syslog</log_format></localfile>
  <localfile><location>/var/log/soc-lab/auth-fixture.log</location><log_format>syslog</log_format></localfile>
  <localfile><location>/var/log/soc-lab/windows-fixture.jsonl</location><log_format>json</log_format></localfile>
  <localfile><location>/var/log/soc-lab/app.jsonl</location><log_format>json</log_format></localfile>
  <localfile><location>/var/log/soc-lab/suricata/eve.json</location><log_format>json</log_format></localfile>
  <localfile><location>/var/log/audit/audit.log</location><log_format>audit</log_format></localfile>
</ossec_config>
